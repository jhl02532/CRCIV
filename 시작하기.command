#!/bin/bash
# CRCIV 로컬 서버 실행 스크립트

# 현재 스크립트 위치로 이동
cd "$(dirname "$0")"

echo "------------------------------------------------"
echo "CRCIV 홈페이지 로컬 서버를 시작합니다..."
echo "이 창을 닫으면 서버가 종료됩니다."
echo "------------------------------------------------"

# 기본 브라우저로 접속
open "http://localhost:8000/blog.html"

# 파이썬 기본 서버 실행 (Mac 기본 탑재)
python3 -m http.server 8000
